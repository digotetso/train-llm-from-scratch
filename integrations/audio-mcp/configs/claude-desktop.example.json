{
  "mcpServers": {
    "audacity": {
      "command": "__ABSOLUTE_REPOSITORY_ROOT__/integrations/audio-mcp/.venv-audacity/bin/audio-mcp-audacity",
      "args": []
    },
    "audition": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "__ABSOLUTE_REPOSITORY_ROOT__/integrations/audio-mcp",
        "audio-mcp-audition"
      ],
      "env": {
        "AUDIO_MCP_AUDITION_CONFIG": "__USER_APPLICATION_SUPPORT__/audio-mcp/audition.json"
      }
    }
  }
}
