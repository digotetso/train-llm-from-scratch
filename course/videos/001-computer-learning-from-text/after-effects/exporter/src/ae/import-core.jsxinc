 */

var Video001ExporterCore = (function () {
    function escapeRegularExpression(value) {
        return value.replace(/([\\^$.*+?()[\]{}|])/g, "\\$1");
    }

    function padVersion(value) {
        if (value < 10) {
            return "00" + value;
        }
        if (value < 100) {
            return "0" + value;
        }
        return String(value);
    }

    function truncateWithoutSplittingSurrogate(value, maxLength) {
        var result = value.substring(0, maxLength);
        var lastCode;
        if (result.length > 0) {
            lastCode = result.charCodeAt(result.length - 1);
            if (lastCode >= 55296 && lastCode <= 56319) {
                result = result.substring(0, result.length - 1);
            }
        }
        return result;
    }

    function nextVersionName(existingNames, baseName) {
        var versionBase = truncateWithoutSplittingSurrogate(baseName, 115);
        var pattern = new RegExp("^" + escapeRegularExpression(versionBase) + "_v([0-9]{3})$");
        var highest = 0;
        var index;
        var match;
        var version;

        for (index = 0; index < existingNames.length; index += 1) {
            match = pattern.exec(existingNames[index]);
            if (match) {
                version = parseInt(match[1], 10);
                if (version > highest) {
                    highest = version;
                }
            }
        }

        if (highest >= 999) {
            throw new Error("Cannot create version beyond " + versionBase + "_v999");
        }

        return versionBase + "_v" + padVersion(highest + 1);
    }

    function scaleRect(rect, sourceWidth, sourceHeight, targetWidth, targetHeight) {
        var scaleX = targetWidth / sourceWidth;
        var scaleY = targetHeight / sourceHeight;
        return {
            x: rect.x * scaleX,
            y: rect.y * scaleY,
            width: rect.width * scaleX,
            height: rect.height * scaleY
        };
    }

    function sanitizeAeName(name) {
        var segments = String(name).replace(new RegExp("\\\\", "g"), "/").split("/");
        var safeName = "";
        var index;

        for (index = 0; index < segments.length; index += 1) {
            if (segments[index] !== "" && segments[index] !== "." && segments[index] !== "..") {
                safeName = segments[index];
            }
        }

        safeName = safeName.replace(/[\u0000-\u001F\u007F-\u009F\u00AD\u200B-\u200F\u2028-\u202E\u2060\u2066-\u2069\uFEFF]/g, "");
        safeName = safeName.replace(/[^A-Za-z0-9 _.\-\u00A0-\uFFFF]/g, "_");
        if (safeName === "" || safeName === "." || safeName === "..") {
            safeName = "Untitled";
        }
        return truncateWithoutSplittingSurrogate(safeName, 120);
    }

    function isDuplicateHash(items, contentHash) {
        var expectedComment = "Video001Export sha256:" + contentHash;
        var index;
        for (index = 0; index < items.length; index += 1) {
            if (items[index] && items[index].comment === expectedComment) {
                return true;
            }
        }
        return false;
    }

    function copyArray(values) {
        var result = [];
        var index;
        for (index = 0; index < values.length; index += 1) {
            result[result.length] = values[index];
        }
        return result;
    }

    function copyRecords(values) {
        var result = [];
        var index;
        var propertyName;
        var sourceRecord;
        var copiedRecord;
        for (index = 0; index < values.length; index += 1) {
            sourceRecord = values[index];
            copiedRecord = {};
            for (propertyName in sourceRecord) {
                if (
                    Object.prototype.hasOwnProperty.call(sourceRecord, propertyName) &&
                    propertyName !== "__proto__" &&
                    propertyName !== "constructor" &&
                    propertyName !== "prototype"
                ) {
                    copiedRecord[propertyName] = sourceRecord[propertyName];
                }
            }
            result[result.length] = copiedRecord;
        }
        return result;
    }

    function makeImportReport(options) {
        return {
            contentHash: options.contentHash,
            createdCompNames: copyArray(options.createdCompNames),
            layerCount: options.layerCount,
            nativeCount: options.nativeCount,
            rasterCount: options.rasterCount,
            missingFonts: copyArray(options.missingFonts),
            fallbacks: copyRecords(options.fallbacks),
            warnings: copyArray(options.warnings),
            elapsedMs: options.elapsedMs
        };
    }

    return {
        nextVersionName: nextVersionName,
        scaleRect: scaleRect,
        sanitizeAeName: sanitizeAeName,
        isDuplicateHash: isDuplicateHash,
        makeImportReport: makeImportReport
    };
}());
