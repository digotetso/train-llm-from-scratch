/*
 * Video 001 Figma to After Effects Exporter native importer.
 *
 * This file uses concepts from AEUX and has been modified for this exporter.
 * Copyright 2017 Google Inc.
 * Licensed under the Apache License, Version 2.0.
 */

var Video001ExporterImporter = (function (core) {
    var HASH_PATTERN = /^[0-9a-f]{64}$/;
    var PACKAGE_SUFFIX = ".video001-ae.json";
    var FALLBACK_FONT = "Inter-Regular";
    var BASE64_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    var MAX_ASSET_BYTES = 32 * 1024 * 1024;
    var MAX_AGGREGATE_ASSET_BYTES = 512 * 1024 * 1024;

    File.encoding = "UTF-8";

    function readUtf8(file) {
        var value;
        file.encoding = "UTF-8";
        if (!file.open("r")) {
            throw new Error("Cannot open UTF-8 file: " + file.fsName);
        }
        try {
            value = file.read();
        } finally {
            file.close();
        }
        return value;
    }

    function writeUtf8(file, value) {
        file.encoding = "UTF-8";
        if (!file.open("w")) {
            throw new Error("Cannot write UTF-8 file: " + file.fsName);
        }
        try {
            if (!file.write(value)) {
                throw new Error("Cannot complete UTF-8 write: " + file.fsName);
            }
        } finally {
            file.close();
        }
    }

    function requireObject(value, label) {
        if (value === null || typeof value !== "object" || value instanceof Array) {
            throw new Error(label + " must be an object");
        }
        return value;
    }

    function requireArray(value, label) {
        if (!(value instanceof Array)) {
            throw new Error(label + " must be an array");
        }
        return value;
    }

    function requireString(value, label, allowEmpty) {
        if (typeof value !== "string" || (!allowEmpty && value.length === 0)) {
            throw new Error(label + " must be a string");
        }
        return value;
    }

    function requireNumber(value, label, minimum) {
        if (typeof value !== "number" || !isFinite(value) || value < minimum) {
            throw new Error(label + " must be a finite number no smaller than " + minimum);
        }
        return value;
    }

    function requirePositiveNumber(value, label) {
        requireNumber(value, label, 0);
        if (value === 0) {
            throw new Error(label + " must be positive");
        }
        return value;
    }

    function requireHash(value, label) {
        if (typeof value !== "string" || !HASH_PATTERN.test(value)) {
            throw new Error(label + " must be a lowercase SHA-256 hash");
        }
        return value;
    }

    function clamp(value, low, high) {
        return Math.max(low, Math.min(high, value));
    }

    function hexToRgb(hex) {
        var clean = String(hex || "#FFFFFF").replace("#", "");
        if (!/^[0-9A-Fa-f]{6}$/.test(clean)) {
            throw new Error("Invalid RGB color " + String(hex));
        }
        return [
            parseInt(clean.substring(0, 2), 16) / 255,
            parseInt(clean.substring(2, 4), 16) / 255,
            parseInt(clean.substring(4, 6), 16) / 255
        ];
    }

    function quoteShellArgument(value) {
        return "'" + String(value).replace(/'/g, "'\\''") + "'";
    }

    function canonicalJson(value) {
        var keys = [];
        var parts = [];
        var key;
        var index;
        var serialized;
        if (value === null || typeof value !== "object") {
            serialized = JSON.stringify(value);
            if (serialized === undefined) {
                throw new Error("Cannot canonicalize a non-JSON package value");
            }
            return serialized;
        }
        if (value instanceof Array) {
            for (index = 0; index < value.length; index += 1) {
                parts[parts.length] = canonicalJson(value[index]);
            }
            return "[" + parts.join(",") + "]";
        }
        for (key in value) {
            if (Object.prototype.hasOwnProperty.call(value, key)) {
                keys[keys.length] = key;
            }
        }
        keys.sort();
        for (index = 0; index < keys.length; index += 1) {
            key = keys[index];
            parts[parts.length] = JSON.stringify(key) + ":" + canonicalJson(value[key]);
        }
        return "{" + parts.join(",") + "}";
    }

    function verifyManualContentFingerprint(packageValue) {
        var packageObject = requireObject(packageValue, "Exporter package");
        var assets = requireArray(packageObject.assets, "Exporter package assets");
        var fingerprintValue = {};
        var temporary;
        var expectedHash = requireHash(packageObject.contentHash, "Exporter package contentHash");
        var actualHash;
        var key;
        var index;
        for (index = 0; index < assets.length; index += 1) {
            requireObject(assets[index], "Exporter package asset " + index);
            if (
                typeof assets[index].dataBase64 !== "string" ||
                (typeof assets[index].path === "string" && assets[index].path.length > 0)
            ) {
                throw new Error("Manual imports must contain inline raster data so the declared content fingerprint can be verified");
            }
        }
        for (key in packageObject) {
            if (Object.prototype.hasOwnProperty.call(packageObject, key)) {
                fingerprintValue[key] = packageObject[key];
            }
        }
        fingerprintValue.exportedAt = "";
        fingerprintValue.contentHash = "";
        temporary = new File(
            Folder.temp.fsName + "/video001-package-fingerprint-" +
            String(new Date().getTime()) + "-" + String(Math.floor(Math.random() * 1000000000)) + ".json"
        );
        try {
            writeUtf8(temporary, canonicalJson(fingerprintValue));
            system.callSystem("/bin/chmod 600 " + quoteShellArgument(temporary.fsName));
            actualHash = sha256File(temporary);
        } finally {
            if (temporary.exists && !temporary.remove()) {
                throw new Error("Cannot remove temporary manual package fingerprint input");
            }
        }
        if (actualHash !== expectedHash) {
            throw new Error("Manual package content fingerprint does not match its declared content hash");
        }
    }

    function decodeCanonicalBase64(value) {
        var source = String(value);
        var parts = [];
        var part = "";
        var first;
        var second;
        var third;
        var fourth;
        var bits;
        var sourceIndex;
        if (
            source.length % 4 !== 0 ||
            !new RegExp("^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$").test(source)
        ) {
            throw new Error("Manual raster fallback is not canonical base64");
        }
        if (source.substring(source.length - 2) === "==") {
            if ((BASE64_ALPHABET.indexOf(source.charAt(source.length - 3)) & 15) !== 0) {
                throw new Error("Manual raster fallback base64 has non-zero pad bits");
            }
        } else if (source.charAt(source.length - 1) === "=") {
            if ((BASE64_ALPHABET.indexOf(source.charAt(source.length - 2)) & 3) !== 0) {
                throw new Error("Manual raster fallback base64 has non-zero pad bits");
            }
        }
        for (sourceIndex = 0; sourceIndex < source.length; sourceIndex += 4) {
            first = BASE64_ALPHABET.indexOf(source.charAt(sourceIndex));
            second = BASE64_ALPHABET.indexOf(source.charAt(sourceIndex + 1));
            third = source.charAt(sourceIndex + 2) === "=" ? 0 : BASE64_ALPHABET.indexOf(source.charAt(sourceIndex + 2));
            fourth = source.charAt(sourceIndex + 3) === "=" ? 0 : BASE64_ALPHABET.indexOf(source.charAt(sourceIndex + 3));
            bits = (first << 18) | (second << 12) | (third << 6) | fourth;
            part += String.fromCharCode((bits >>> 16) & 255);
            if (source.charAt(sourceIndex + 2) !== "=") {
                part += String.fromCharCode((bits >>> 8) & 255);
            }
            if (source.charAt(sourceIndex + 3) !== "=") {
                part += String.fromCharCode(bits & 255);
            }
            if (part.length >= 8192) {
                parts[parts.length] = part;
                part = "";
            }
        }
        if (part.length > 0) {
            parts[parts.length] = part;
        }
        return parts.join("");
    }

    function writeBinary(file, value) {
        file.encoding = "BINARY";
        if (!file.open("w")) {
            throw new Error("Cannot create manual raster temporary file");
        }
        try {
            if (!file.write(value)) {
                throw new Error("Cannot complete manual raster temporary write");
            }
        } finally {
            file.close();
        }
    }

    function sha256File(file) {
        var output = system.callSystem("/usr/bin/shasum -a 256 " + quoteShellArgument(file.fsName));
        var match = /^([0-9a-f]{64})\b/.exec(String(output));
        if (match === null) {
            throw new Error("Cannot verify manual raster SHA-256");
        }
        return match[1];
    }

    function verifyAssetFile(file, expectedHash, expectedByteLength) {
        if (!file.exists || file.length !== expectedByteLength || sha256File(file) !== expectedHash) {
            throw new Error("Raster fallback file does not match its declared byte length and SHA-256");
        }
    }

    function materializeInlineAsset(asset, expectedAssetRoot) {
        var destination;
        var temporary;
        var bytes;
        if (!expectedAssetRoot.exists && !expectedAssetRoot.create()) {
            throw new Error("Cannot create exporter content-addressed asset directory");
        }
        destination = new File(expectedAssetRoot.fsName + "/" + asset.hash + ".png");
        if (destination.exists) {
            verifyAssetFile(destination, asset.hash, asset.byteLength);
            return destination;
        }
        bytes = decodeCanonicalBase64(asset.dataBase64);
        if (bytes.length !== asset.byteLength) {
            throw new Error("Manual raster fallback byte length does not match its descriptor");
        }
        temporary = new File(
            expectedAssetRoot.fsName + "/." + asset.hash + "." +
            String(new Date().getTime()) + "." + String(Math.floor(Math.random() * 1000000000)) + ".tmp"
        );
        try {
            writeBinary(temporary, bytes);
            system.callSystem("/bin/chmod 600 " + quoteShellArgument(temporary.fsName));
            verifyAssetFile(temporary, asset.hash, asset.byteLength);
            if (!temporary.rename(destination.name)) {
                if (destination.exists) {
                    verifyAssetFile(destination, asset.hash, asset.byteLength);
                    if (temporary.exists) {
                        temporary.remove();
                    }
                } else {
                    throw new Error("Cannot publish verified manual raster fallback");
                }
            }
            verifyAssetFile(destination, asset.hash, asset.byteLength);
            return destination;
        } catch (materializeError) {
            if (temporary.exists) {
                temporary.remove();
            }
            throw materializeError;
        }
    }

    function sameColor(first, second) {
        return String(first).toUpperCase() === String(second).toUpperCase();
    }

    function appendUnique(values, value) {
        var index;
        for (index = 0; index < values.length; index += 1) {
            if (values[index] === value) {
                return;
            }
        }
        values[values.length] = value;
    }

    function appendFallback(state, value) {
        state.fallbacks[state.fallbacks.length] = value;
    }

    function loadTiming(timingFile) {
        var timing = requireObject(JSON.parse(readUtf8(timingFile)), "Video 001 timing");
        var canvas = requireObject(timing.canvas, "Video 001 timing canvas");
        var source = requireObject(timing.source, "Video 001 timing source");
        var shots = requireArray(timing.shots, "Video 001 timing shots");
        var byNodeId = {};
        var index;
        var shot;

        if (
            canvas.width !== 1920 ||
            canvas.height !== 1080 ||
            canvas.fps !== 30 ||
            canvas.timeUnit !== "seconds" ||
            canvas.duration !== 840
        ) {
            throw new Error("Video 001 timing must remain exactly 1920x1080, 30 fps, and 840 seconds");
        }
        requireString(source.figmaFileKey, "Video 001 Figma file key", false);
        requireString(source.figmaPageNodeId, "Video 001 Figma page ID", false);
        for (index = 0; index < shots.length; index += 1) {
            shot = requireObject(shots[index], "Video 001 shot " + index);
            requireString(shot.figmaNodeId, "Video 001 shot node ID", false);
            requireString(shot.name, "Video 001 shot name", false);
            requirePositiveNumber(shot.duration, "Video 001 shot duration");
            if (byNodeId[shot.figmaNodeId] !== undefined) {
                throw new Error("Video 001 timing contains a duplicate shot node ID");
            }
            byNodeId[shot.figmaNodeId] = shot;
        }
        return {
            canvas: canvas,
            source: source,
            shotsByNodeId: byNodeId
        };
    }

    function validateBaseNode(node, label) {
        requireString(node.id, label + ".id", false);
        requireString(node.name, label + ".name", false);
        requireNumber(node.x, label + ".x", -9007199254740991);
        requireNumber(node.y, label + ".y", -9007199254740991);
        requirePositiveNumber(node.width, label + ".width");
        requirePositiveNumber(node.height, label + ".height");
        requireNumber(node.rotation, label + ".rotation", -9007199254740991);
        requireNumber(node.opacity, label + ".opacity", 0);
        if (node.opacity > 1) {
            throw new Error(label + ".opacity must not exceed one");
        }
    }

    function validateNode(nodeValue, label, assetByHash, referencedAssets) {
        var node = requireObject(nodeValue, label);
        var textBox;
        var paragraph;
        var runs;
        var run;
        var children;
        var index;
        validateBaseNode(node, label);

        if (node.kind === "text") {
            requireString(node.text, label + ".text", true);
            textBox = requireObject(node.textBox, label + ".textBox");
            requirePositiveNumber(textBox.width, label + ".textBox.width");
            requirePositiveNumber(textBox.height, label + ".textBox.height");
            paragraph = requireObject(node.paragraph, label + ".paragraph");
            if (paragraph.align !== "LEFT" && paragraph.align !== "CENTER" && paragraph.align !== "RIGHT") {
                throw new Error(label + ".paragraph.align is unsupported");
            }
            requirePositiveNumber(paragraph.lineHeightPx, label + ".paragraph.lineHeightPx");
            requireNumber(paragraph.letterSpacingPx, label + ".paragraph.letterSpacingPx", -9007199254740991);
            runs = requireArray(node.runs, label + ".runs");
            for (index = 0; index < runs.length; index += 1) {
                run = requireObject(runs[index], label + ".runs[" + index + "]");
                requireNumber(run.start, label + ".runs[" + index + "].start", 0);
                requirePositiveNumber(run.end, label + ".runs[" + index + "].end");
                if (Math.floor(run.start) !== run.start || Math.floor(run.end) !== run.end || run.end <= run.start || run.end > node.text.length) {
                    throw new Error(label + ".runs[" + index + "] has an invalid text range");
                }
                requireString(run.fontFamily, label + ".runs[" + index + "].fontFamily", false);
                requireString(run.fontStyle, label + ".runs[" + index + "].fontStyle", false);
                requirePositiveNumber(run.fontSize, label + ".runs[" + index + "].fontSize");
                hexToRgb(run.color);
            }
            return;
        }

        if (node.kind === "rect" || node.kind === "ellipse") {
            if (node.fill !== null) {
                hexToRgb(node.fill);
            }
            if (node.stroke !== null) {
                hexToRgb(node.stroke);
            }
            requireNumber(node.strokeWidth, label + ".strokeWidth", 0);
            requireNumber(node.radius, label + ".radius", 0);
            return;
        }

        if (node.kind === "group") {
            children = requireArray(node.children, label + ".children");
            for (index = 0; index < children.length; index += 1) {
                validateNode(children[index], label + ".children[" + index + "]", assetByHash, referencedAssets);
            }
            return;
        }

        if (node.kind === "raster") {
            requireHash(node.assetHash, label + ".assetHash");
            if (assetByHash[node.assetHash] === undefined) {
                throw new Error(label + " references a raster asset absent from the package");
            }
            referencedAssets[node.assetHash] = true;
            return;
        }

        throw new Error(label + " has unsupported kind " + String(node.kind));
    }

    function validateAssetPath(asset, expectedAssetRoot) {
        var assetFile;
        if (typeof asset.path === "string" && asset.path.length > 0) {
            assetFile = new File(asset.path);
            if (
                !assetFile.exists ||
                assetFile.name !== asset.hash + ".png" ||
                assetFile.parent.fsName !== expectedAssetRoot.fsName
            ) {
                throw new Error("Raster fallback path is outside the verified content-addressed asset directory");
            }
            verifyAssetFile(assetFile, asset.hash, asset.byteLength);
        } else if (typeof asset.dataBase64 === "string") {
            assetFile = materializeInlineAsset(asset, expectedAssetRoot);
        } else {
            throw new Error("Raster fallback " + asset.hash + " has no verifiable queue path or inline data");
        }
        asset.file = assetFile;
    }

    function validatePackage(packageValue, timing, expectedAssetRoot) {
        var packageObject = requireObject(packageValue, "Exporter package");
        var target = requireObject(packageObject.target, "Exporter package target");
        var source = requireObject(packageObject.source, "Exporter package source");
        var assets = requireArray(packageObject.assets, "Exporter package assets");
        var frames = requireArray(packageObject.frames, "Exporter package frames");
        var assetByHash = {};
        var referencedAssets = {};
        var asset;
        var frame;
        var expectedShot;
        var warnings;
        var aggregateAssetBytes = 0;
        var index;
        var childIndex;

        if (packageObject.schemaVersion !== "2.0.0") {
            throw new Error(
                "Exporter package schema " +
                String(packageObject.schemaVersion) +
                " is unsupported; this exporter requires 2.0.0"
            );
        }
        requireHash(packageObject.contentHash, "Exporter package contentHash");
        if (
            target.width !== 1920 ||
            target.height !== 1080 ||
            target.fps !== 30 ||
            target.timeUnit !== "seconds"
        ) {
            throw new Error("Exporter package target must be exactly 1920x1080 at 30 fps with durations in seconds");
        }
        if (
            source.fileKey !== timing.source.figmaFileKey ||
            source.pageId !== timing.source.figmaPageNodeId
        ) {
            throw new Error("Exporter package does not belong to the approved Video 001 Figma page");
        }
        if (frames.length === 0 || frames.length > 48) {
            throw new Error("Exporter package must contain between one and 48 frames");
        }

        for (index = 0; index < assets.length; index += 1) {
            asset = requireObject(assets[index], "Exporter package asset " + index);
            requireHash(asset.hash, "Exporter package asset hash");
            if (asset.mimeType !== "image/png" || assetByHash[asset.hash] !== undefined) {
                throw new Error("Exporter package raster assets must be unique PNG hashes");
            }
            requireNumber(asset.byteLength, "Exporter package asset byteLength", 0);
            if (Math.floor(asset.byteLength) !== asset.byteLength || asset.byteLength > MAX_ASSET_BYTES) {
                throw new Error("Exporter package raster asset exceeds its approved byte limit");
            }
            aggregateAssetBytes += asset.byteLength;
            if (aggregateAssetBytes > MAX_AGGREGATE_ASSET_BYTES) {
                throw new Error("Exporter package raster assets exceed their aggregate byte limit");
            }
            assetByHash[asset.hash] = asset;
        }

        for (index = 0; index < frames.length; index += 1) {
            frame = requireObject(frames[index], "Exporter package frame " + index);
            requireString(frame.nodeId, "Exporter package frame nodeId", false);
            requireString(frame.name, "Exporter package frame name", false);
            requirePositiveNumber(frame.width, "Exporter package frame width");
            requirePositiveNumber(frame.height, "Exporter package frame height");
            requirePositiveNumber(frame.duration, "Exporter package frame duration");
            if (
                Math.abs(
                    frame.duration * target.fps -
                    Math.round(frame.duration * target.fps)
                ) > 0.000000001
            ) {
                throw new Error("Exporter package frame duration in seconds must align to a whole frame");
            }
            expectedShot = timing.shotsByNodeId[frame.nodeId];
            if (
                expectedShot === undefined ||
                expectedShot.name !== frame.name ||
                expectedShot.duration !== frame.duration
            ) {
                throw new Error("Exporter package frame does not match the approved Video 001 timing");
            }
            frame.children = requireArray(frame.children, "Exporter package frame children");
            if (frame.children.length === 0) {
                throw new Error("Exporter package frame cannot be empty");
            }
            for (childIndex = 0; childIndex < frame.children.length; childIndex += 1) {
                validateNode(frame.children[childIndex], "frame.children[" + childIndex + "]", assetByHash, referencedAssets);
            }
            warnings = requireArray(frame.warnings, "Exporter package frame warnings");
            for (childIndex = 0; childIndex < warnings.length; childIndex += 1) {
                requireObject(warnings[childIndex], "Exporter package frame warning");
            }
        }

        for (index = 0; index < assets.length; index += 1) {
            asset = assets[index];
            validateAssetPath(asset, expectedAssetRoot);
        }
        packageObject.assetByHash = assetByHash;
        return packageObject;
    }

    function rememberItem(transactionItems, item) {
        if (
            !(item instanceof FolderItem) &&
            !(item instanceof CompItem) &&
            !(item instanceof FootageItem)
        ) {
            throw new Error("Importer transaction may record only After Effects Item references");
        }
        transactionItems[transactionItems.length] = item;
        return item;
    }

    function rollbackItems(transactionItems) {
        var transactionIndex;
        var rollbackError = null;
        for (transactionIndex = transactionItems.length - 1; transactionIndex >= 0; transactionIndex -= 1) {
            try {
                transactionItems[transactionIndex].remove();
            } catch (itemRemovalError) {
                if (rollbackError === null) {
                    rollbackError = itemRemovalError;
                }
            }
        }
        if (rollbackError !== null) {
            throw new Error("Import failed and rollback could not remove every new transaction item: " + rollbackError.toString());
        }
    }

    function allProjectItems() {
        var items = [];
        var index;
        for (index = 1; index <= app.project.numItems; index += 1) {
            items[items.length] = app.project.item(index);
        }
        return items;
    }

    function allProjectItemNames() {
        var names = [];
        var index;
        for (index = 1; index <= app.project.numItems; index += 1) {
            names[names.length] = app.project.item(index).name;
        }
        return names;
    }

    function findFolder(name, parentFolder) {
        var item;
        var index;
        for (index = 1; index <= app.project.numItems; index += 1) {
            item = app.project.item(index);
            if (item instanceof FolderItem && item.name === name && item.parentFolder === parentFolder) {
                return item;
            }
        }
        return null;
    }

    function ensureRootFolder(transactionItems) {
        var folder = findFolder("01_Exporter_Imports", app.project.rootFolder);
        if (folder === null) {
            folder = rememberItem(transactionItems, app.project.items.addFolder("01_Exporter_Imports"));
        }
        return folder;
    }

    function ensureChildFolder(name, parentFolder, transactionItems) {
        var folder = findFolder(name, parentFolder);
        if (folder === null) {
            folder = rememberItem(transactionItems, app.project.items.addFolder(name));
            folder.parentFolder = parentFolder;
        }
        return folder;
    }

    function fontCandidates(run) {
        var family = String(run.fontFamily || "Inter");
        var style = String(run.fontStyle || "Regular");
        var compactFamily = family.replace(/ /g, "");
        var values = [
            family + "-" + style,
            compactFamily + "-" + style,
            family + " " + style
        ];
        values[values.length] = FALLBACK_FONT;
        return values;
    }

    function findFontByPostScriptName(postScriptName) {
        var matches;
        if (!app.fonts || !app.fonts.getFontsByPostScriptName) {
            throw new Error("After Effects font lookup is unavailable");
        }
        try {
            matches = app.fonts.getFontsByPostScriptName(postScriptName);
            if (matches && matches.length > 0) {
                return matches[0];
            }
        } catch (fontLookupError) {
            return null;
        }
        return null;
    }

    function resolveRunFont(run, node, state) {
        var candidates = fontCandidates(run);
        var requested = candidates[0];
        var runText = node.text.substring(run.start, run.end).replace(new RegExp("[\\r\\n]", "g"), "");
        var fontObject = null;
        var replacement = "";
        var index;
        for (index = 0; index < candidates.length; index += 1) {
            fontObject = findFontByPostScriptName(candidates[index]);
            if (fontObject !== null) {
                try {
                    if (runText.length === 0 || fontObject.hasGlyphsFor(runText)) {
                        replacement = fontObject.postScriptName;
                        break;
                    }
                } catch (glyphCoverageError) {
                    fontObject = null;
                }
                fontObject = null;
            }
        }
        if (fontObject === null || replacement === "") {
            throw new Error("Required fallback font " + FALLBACK_FONT + " is not installed");
        }
        if (replacement !== requested) {
            appendUnique(state.missingFonts, requested);
            appendFallback(state, {
                type: "font-substitution",
                nodeId: node.id,
                nodeName: node.name,
                property: "font",
                start: run.start,
                end: run.end,
                requested: requested,
                replacement: replacement
            });
            state.warnings[state.warnings.length] = "Substituted " + requested + " with " + replacement + " on " + node.name;
        }
        return {
            fontObject: fontObject,
            postScriptName: replacement,
            requested: requested,
            fauxBold: replacement === FALLBACK_FONT &&
                replacement !== requested &&
                new RegExp("(?:bold|black|heavy)", "i").test(String(run.fontStyle || ""))
        };
    }

    function applyResolvedFont(documentValue, resolved) {
        documentValue.fontObject = resolved.fontObject;
        documentValue.fauxBold = resolved.fauxBold;
    }

    function dominantRunIndex(runs) {
        var dominantIndex = 0;
        var dominantLength = -1;
        var index;
        var length;
        for (index = 0; index < runs.length; index += 1) {
            length = runs[index].end - runs[index].start;
            if (length > dominantLength) {
                dominantIndex = index;
                dominantLength = length;
            }
        }
        return dominantIndex;
    }

    function runDiffers(run, resolved, dominantRun, dominantResolved) {
        return (
            resolved.postScriptName !== dominantResolved.postScriptName ||
            resolved.fauxBold !== dominantResolved.fauxBold ||
            run.fontSize !== dominantRun.fontSize ||
            !sameColor(run.color, dominantRun.color)
        );
    }

    function addRunAnimator(layer, run, dominantRun, scaleY) {
        var textProperties = layer.property("ADBE Text Properties");
        var animators = textProperties.property("ADBE Text Animators");
        var animator = animators.addProperty("ADBE Text Animator");
        var animatorProperties = animator.property("ADBE Text Animator Properties");
        var selector = animator.property("ADBE Text Selectors").addProperty("ADBE Text Selector");
        var advanced = selector.property("ADBE Text Range Advanced");
        var property;
        animator.name = "Video001 mixed run " + run.start + "-" + run.end;
        if (advanced === null) {
            throw new Error("After Effects text range advanced settings are unavailable");
        }
        property = advanced.property("ADBE Text Range Units");
        if (property === null) {
            throw new Error("After Effects text range units are unavailable");
        }
        property.setValue(2);
        property = selector.property("ADBE Text Index Start");
        if (property === null) {
            throw new Error("After Effects text range start is unavailable");
        }
        property.setValue(run.start);
        property = selector.property("ADBE Text Index End");
        if (property === null) {
            throw new Error("After Effects text range end is unavailable");
        }
        property.setValue(run.end);
        property = animatorProperties.addProperty("ADBE Text Fill Color");
        property.setValue(hexToRgb(run.color));
        if (run.fontSize !== dominantRun.fontSize) {
            property = animatorProperties.addProperty("ADBE Text Font Size");
            property.setValue((run.fontSize - dominantRun.fontSize) * scaleY);
        }
    }

    function setLayerGeometry(layer, rect, rotation, opacity, boxTextPos) {
        var radians = rotation * Math.PI / 180;
        var centerX = rect.x + Math.cos(radians) * rect.width / 2 - Math.sin(radians) * rect.height / 2;
        var centerY = rect.y + Math.sin(radians) * rect.width / 2 + Math.cos(radians) * rect.height / 2;
        var anchorX = 0;
        var anchorY = 0;
        var transform = layer.property("ADBE Transform Group");
        if (boxTextPos !== undefined) {
            if (
                boxTextPos === null ||
                boxTextPos.length === undefined ||
                boxTextPos.length < 2 ||
                typeof boxTextPos[0] !== "number" ||
                typeof boxTextPos[1] !== "number" ||
                !isFinite(boxTextPos[0]) ||
                !isFinite(boxTextPos[1])
            ) {
                throw new Error("After Effects paragraph box position is unavailable");
            }
            anchorX = boxTextPos[0] + rect.width / 2;
            anchorY = boxTextPos[1] + rect.height / 2;
        }
        transform.property("ADBE Anchor Point").setValue([anchorX, anchorY]);
        transform.property("ADBE Position").setValue([centerX, centerY]);
        transform.property("ADBE Rotate Z").setValue(rotation);
        transform.property("ADBE Opacity").setValue(clamp(Math.round(opacity * 100), 0, 100));
    }

    function addText(comp, node, context) {
        var textBox = core.scaleRect(
            { x: node.x, y: node.y, width: node.textBox.width, height: node.textBox.height },
            context.frame.width,
            context.frame.height,
            context.target.width,
            context.target.height
        );
        var scaleY = context.target.height / context.frame.height;
        var runs = node.runs;
        var syntheticRun;
        var dominantIndex;
        var dominantRun;
        var resolvedRuns = [];
        var dominantResolved;
        var layer;
        var source;
        var documentValue;
        var range;
        var index;

        if (runs.length === 0) {
            syntheticRun = {
                start: 0,
                end: node.text.length,
                fontFamily: "Inter",
                fontStyle: "Regular",
                fontSize: Math.max(1, node.paragraph.lineHeightPx),
                color: "#FFFFFF"
            };
            runs = [syntheticRun];
        }
        dominantIndex = dominantRunIndex(runs);
        dominantRun = runs[dominantIndex];
        for (index = 0; index < runs.length; index += 1) {
            resolvedRuns[index] = resolveRunFont(runs[index], node, context.state);
        }
        dominantResolved = resolvedRuns[dominantIndex];

        layer = comp.layers.addBoxText([textBox.width, textBox.height]);
        layer.name = core.sanitizeAeName(node.name);
        layer.comment = "Figma native text " + node.id;
        source = layer.property("ADBE Text Properties").property("ADBE Text Document");
        documentValue = source.value;
        documentValue.resetCharStyle();
        documentValue.resetParagraphStyle();
        documentValue.text = node.text;
        applyResolvedFont(documentValue, dominantResolved);
        documentValue.fontSize = dominantRun.fontSize * scaleY;
        documentValue.applyFill = true;
        documentValue.fillColor = hexToRgb(dominantRun.color);
        documentValue.applyStroke = false;
        documentValue.autoLeading = false;
        documentValue.leading = node.paragraph.lineHeightPx * scaleY;
        documentValue.tracking = dominantRun.fontSize === 0 ? 0 : node.paragraph.letterSpacingPx * 1000 / dominantRun.fontSize;
        if (node.paragraph.align === "CENTER") {
            documentValue.justification = ParagraphJustification.CENTER_JUSTIFY;
        } else if (node.paragraph.align === "RIGHT") {
            documentValue.justification = ParagraphJustification.RIGHT_JUSTIFY;
        } else {
            documentValue.justification = ParagraphJustification.LEFT_JUSTIFY;
        }
        source.setValue(documentValue);

        if (runs.length > 1) {
            documentValue = source.value;
            if (typeof documentValue.characterRange !== "function") {
                throw new Error("After Effects 25.2.2 character ranges are required for mixed text styles");
            }
            for (index = 0; index < runs.length; index += 1) {
                if (index !== dominantIndex && runDiffers(runs[index], resolvedRuns[index], dominantRun, dominantResolved)) {
                    range = documentValue.characterRange(runs[index].start, runs[index].end);
                    applyResolvedFont(range, resolvedRuns[index]);
                    addRunAnimator(layer, runs[index], dominantRun, scaleY);
                }
            }
            source.setValue(documentValue);
        }

        documentValue = source.value;
        setLayerGeometry(layer, textBox, node.rotation, node.opacity, documentValue.boxTextPos);
        context.state.layerCount += 1;
        context.state.nativeCount += 1;
        return layer;
    }

    function addFillAndStroke(contents, node, scale) {
        var fill;
        var stroke;
        if (node.fill !== null) {
            fill = contents.addProperty("ADBE Vector Graphic - Fill");
            fill.property("ADBE Vector Fill Color").setValue(hexToRgb(node.fill));
            fill.property("ADBE Vector Fill Opacity").setValue(100);
        }
        if (node.stroke !== null && node.strokeWidth > 0) {
            stroke = contents.addProperty("ADBE Vector Graphic - Stroke");
            stroke.property("ADBE Vector Stroke Color").setValue(hexToRgb(node.stroke));
            stroke.property("ADBE Vector Stroke Width").setValue(node.strokeWidth * scale);
            stroke.property("ADBE Vector Stroke Opacity").setValue(100);
        }
    }

    function addShape(comp, node, context) {
        var rect = core.scaleRect(node, context.frame.width, context.frame.height, context.target.width, context.target.height);
        var scaleX = context.target.width / context.frame.width;
        var scaleY = context.target.height / context.frame.height;
        var scale = Math.min(scaleX, scaleY);
        var layer = comp.layers.addShape();
        var contents = layer.property("ADBE Root Vectors Group");
        var shape;
        layer.name = core.sanitizeAeName(node.name);
        layer.comment = "Figma native vector " + node.id + " " + node.kind;
        if (node.kind === "ellipse") {
            shape = contents.addProperty("ADBE Vector Shape - Ellipse");
            shape.property("ADBE Vector Ellipse Size").setValue([rect.width, rect.height]);
        } else {
            shape = contents.addProperty("ADBE Vector Shape - Rect");
            shape.property("ADBE Vector Rect Size").setValue([rect.width, rect.height]);
            shape.property("ADBE Vector Rect Roundness").setValue(node.radius * scale);
        }
        addFillAndStroke(contents, node, scale);
        setLayerGeometry(layer, rect, node.rotation, node.opacity);
        context.state.layerCount += 1;
        context.state.nativeCount += 1;
        return layer;
    }

    function addRaster(comp, node, context) {
        var asset = context.packageObject.assetByHash[node.assetHash];
        var options = new ImportOptions(asset.file);
        var footage = rememberItem(context.transactionItems, app.project.importFile(options));
        var rect = core.scaleRect(node, context.frame.width, context.frame.height, context.target.width, context.target.height);
        var layer;
        var transform;
        footage.parentFolder = context.versionFolder;
        layer = comp.layers.add(footage);
        layer.name = core.sanitizeAeName(node.name);
        layer.comment = "Figma raster fallback " + node.id + " sha256:" + node.assetHash;
        transform = layer.property("ADBE Transform Group");
        transform.property("ADBE Scale").setValue([
            rect.width * 100 / footage.width,
            rect.height * 100 / footage.height
        ]);
        setLayerGeometry(layer, rect, node.rotation, node.opacity);
        transform.property("ADBE Anchor Point").setValue([footage.width / 2, footage.height / 2]);
        context.state.layerCount += 1;
        context.state.rasterCount += 1;
        return layer;
    }

    function addGroup(comp, node, context) {
        var precompName = core.sanitizeAeName(context.frameCompName + "__" + node.name);
        var precomp = rememberItem(
            context.transactionItems,
            app.project.items.addComp(
                precompName,
                context.target.width,
                context.target.height,
                1,
                context.frame.duration,
                context.target.fps
            )
        );
        var childContext = {
            packageObject: context.packageObject,
            frame: context.frame,
            target: context.target,
            state: context.state,
            transactionItems: context.transactionItems,
            versionFolder: context.versionFolder,
            frameCompName: context.frameCompName
        };
        var layer;
        var transform;
        var index;
        precomp.parentFolder = context.versionFolder;
        precomp.comment = "Figma recursive precomp " + node.id;
        for (index = 0; index < node.children.length; index += 1) {
            addNode(precomp, node.children[index], childContext);
        }
        layer = comp.layers.add(precomp);
        layer.name = core.sanitizeAeName(node.name);
        layer.comment = "Figma group precomp " + node.id;
        transform = layer.property("ADBE Transform Group");
        transform.property("ADBE Anchor Point").setValue([context.target.width / 2, context.target.height / 2]);
        transform.property("ADBE Position").setValue([context.target.width / 2, context.target.height / 2]);
        transform.property("ADBE Opacity").setValue(clamp(Math.round(node.opacity * 100), 0, 100));
        context.state.layerCount += 1;
        context.state.nativeCount += 1;
        return layer;
    }

    function addNode(comp, node, context) {
        if (node.kind === "text") {
            return addText(comp, node, context);
        }
        if (node.kind === "rect" || node.kind === "ellipse") {
            return addShape(comp, node, context);
        }
        if (node.kind === "group") {
            return addGroup(comp, node, context);
        }
        return addRaster(comp, node, context);
    }

    function importFrame(frame, packageObject, target, rootFolder, state, transactionItems) {
        var frameBaseName = core.sanitizeAeName(frame.name);
        var compName = core.nextVersionName(allProjectItemNames(), frameBaseName);
        var versionName = compName.substring(compName.length - 4);
        var frameFolder = ensureChildFolder(frameBaseName, rootFolder, transactionItems);
        var versionFolder = ensureChildFolder(versionName, frameFolder, transactionItems);
        var comp = rememberItem(
            transactionItems,
            app.project.items.addComp(
                compName,
                target.width,
                target.height,
                1,
                frame.duration,
                target.fps
            )
        );
        var context;
        var index;
        var warning;
        comp.parentFolder = versionFolder;
        comp.comment = "Video001Export sha256:" + packageObject.contentHash;
        context = {
            packageObject: packageObject,
            frame: frame,
            target: target,
            state: state,
            transactionItems: transactionItems,
            versionFolder: versionFolder,
            frameCompName: compName
        };
        for (index = 0; index < frame.children.length; index += 1) {
            addNode(comp, frame.children[index], context);
        }
        for (index = 0; index < frame.warnings.length; index += 1) {
            warning = frame.warnings[index];
            appendFallback(state, {
                type: "raster-fallback",
                nodeId: warning.nodeId,
                nodeName: warning.nodeName,
                property: warning.property,
                replacement: warning.fallback
            });
            state.warnings[state.warnings.length] = "Raster fallback on " + warning.nodeName + ": " + warning.property;
        }
        state.createdCompNames[state.createdCompNames.length] = compName;
        return comp;
    }

    function reportFileFor(reportFolder, contentHash) {
        if (!reportFolder.exists && !reportFolder.create()) {
            throw new Error("Cannot create exporter report directory");
        }
        return new File(reportFolder.fsName + "/import-report-" + contentHash + ".json");
    }

    function importValidatedPackage(packageValue, options) {
        var startedAt = new Date().getTime();
        var transactionItems = [];
        var timing = loadTiming(options.timingFile);
        var packageObject = validatePackage(packageValue, timing, options.assetRoot);
        var duplicate = core.isDuplicateHash(allProjectItems(), packageObject.contentHash);
        var state;
        var rootFolder;
        var report;
        var reportFile;
        var index;
        var caughtError = null;

        if (duplicate && !options.allowDuplicate) {
            return {
                status: "DUPLICATE_CONTENT",
                report: null,
                reportFile: null
            };
        }

        state = {
            createdCompNames: [],
            layerCount: 0,
            nativeCount: 0,
            rasterCount: 0,
            missingFonts: [],
            fallbacks: [],
            warnings: []
        };

        app.beginUndoGroup("Import Video 001 Figma Frame");
        try {
            rootFolder = ensureRootFolder(transactionItems);
            for (index = 0; index < packageObject.frames.length; index += 1) {
                importFrame(
                    packageObject.frames[index],
                    packageObject,
                    packageObject.target,
                    rootFolder,
                    state,
                    transactionItems
                );
            }
            report = core.makeImportReport({
                contentHash: packageObject.contentHash,
                createdCompNames: state.createdCompNames,
                layerCount: state.layerCount,
                nativeCount: state.nativeCount,
                rasterCount: state.rasterCount,
                missingFonts: state.missingFonts,
                fallbacks: state.fallbacks,
                warnings: state.warnings,
                elapsedMs: new Date().getTime() - startedAt
            });
            reportFile = reportFileFor(options.reportFolder, packageObject.contentHash);
            writeUtf8(reportFile, JSON.stringify(report, null, 2));
        } catch (importError) {
            caughtError = importError;
            try {
                rollbackItems(transactionItems);
            } catch (rollbackError) {
                caughtError = rollbackError;
            }
        } finally {
            app.endUndoGroup();
        }
        if (caughtError !== null) {
            throw caughtError;
        }
        return {
            status: "IMPORTED",
            report: report,
            reportFile: reportFile
        };
    }

    function importPackage(packageValue, options) {
        verifyManualContentFingerprint(packageValue);
        return importValidatedPackage(packageValue, options);
    }

    function trustedQueueRoot() {
        return new Folder(Folder.userData.fsName + "/Video001FigmaAEExporter");
    }

    function isQueuedPackageFile(packageFile, contentHash) {
        var queueRoot = trustedQueueRoot();
        return (
            packageFile.parent.fsName === queueRoot.fsName + "/incoming" &&
            packageFile.name === contentHash + PACKAGE_SUFFIX
        );
    }

    function verifyPackageFileIdentity(packageFile, options, packageValue) {
        var packageObject = requireObject(packageValue, "Exporter package");
        var contentHash = requireHash(packageObject.contentHash, "Exporter package contentHash");
        var queued = isQueuedPackageFile(packageFile, contentHash);
        if (options.removeAfterReport && !queued) {
            throw new Error("Queue package must use the trusted queue root as a direct incoming/<contentHash>.video001-ae.json child");
        }
        if (!queued) {
            verifyManualContentFingerprint(packageObject);
        }
        return queued;
    }

    function importPackageFile(packageFile, options) {
        var packageValue = JSON.parse(readUtf8(packageFile));
        verifyPackageFileIdentity(packageFile, options, packageValue);
        var result = importValidatedPackage(packageValue, options);
        if (
            (result.status === "IMPORTED" || result.status === "DUPLICATE_CONTENT") &&
            options.removeAfterReport &&
            isQueuedPackageFile(packageFile, packageValue.contentHash)
        ) {
            if (!packageFile.remove()) {
                if (result.status === "IMPORTED") {
                    result.report.warnings[result.report.warnings.length] = "Imported queue package could not be removed after report publication";
                    writeUtf8(result.reportFile, JSON.stringify(result.report, null, 2));
                } else {
                    throw new Error("Duplicate queue package could not be removed after no-op");
                }
            }
        }
        return result;
    }

    return {
        importPackage: importPackage,
        importPackageFile: importPackageFile,
        loadTiming: loadTiming,
        readUtf8: readUtf8,
        writeUtf8: writeUtf8
    };
}(Video001ExporterCore));
